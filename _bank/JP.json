[
 {"id":"q151","dim":"JP","dir":-1,"facet":"planning","pair":"C-JP-planning","text":"出门旅行前，我会先把每天的行程排好"},
 {"id":"q152","dim":"JP","dir":-1,"facet":"planning","pair":null,"text":"做一顿晚饭前，我先把要做的步骤理一遍"},
 {"id":"q153","dim":"JP","dir":-1,"facet":"planning","pair":null,"text":"周一开工前，我会想好这件事分几步做"},
 {"id":"q154","dim":"JP","dir":-1,"facet":"planning","pair":null,"text":"这周的周末怎么过，我周四晚上就定好了"},
 {"id":"q155","dim":"JP","dir":-1,"facet":"planning","pair":null,"text":"朋友约我周五吃饭，我先翻下日程表"},
 {"id":"q156","dim":"JP","dir":1,"facet":"planning","pair":"C-JP-planning","text":"周末出门玩，我一般到地方再看有什么可做的"},
 {"id":"q157","dim":"JP","dir":1,"facet":"planning","pair":null,"text":"朋友临时改约到周日下午，我觉得也行"},
 {"id":"q158","dim":"JP","dir":1,"facet":"planning","pair":null,"text":"项目现场出了变动，我当场调整下一步"},
 {"id":"q159","dim":"JP","dir":1,"facet":"planning","pair":null,"text":"周一接到新任务，我习惯先上手再理思路"},
 {"id":"q160","dim":"JP","dir":1,"facet":"planning","pair":null,"text":"周五晚上的时间，我习惯留白不安排"},
 {"id":"q161","dim":"JP","dir":-1,"facet":"structure","pair":"C-JP-structure","text":"家门钥匙和门卡，我固定放在门口的小盘里"},
 {"id":"q162","dim":"JP","dir":-1,"facet":"structure","pair":null,"text":"小组作业第一周，我先把谁做什么分清楚"},
 {"id":"q163","dim":"JP","dir":-1,"facet":"structure","pair":null,"text":"装新买的书架，我照说明书的顺序一步步来"},
 {"id":"q164","dim":"JP","dir":-1,"facet":"structure","pair":null,"text":"办公桌上常用的那几样东西，我能说出放在哪儿"},
 {"id":"q165","dim":"JP","dir":-1,"facet":"structure","pair":null,"text":"去超市买一周的菜，我出门前先写清单"},
 {"id":"q166","dim":"JP","dir":1,"facet":"structure","pair":"C-JP-structure","text":"看完的闲书，我随手就搁在沙发扶手上"},
 {"id":"q167","dim":"JP","dir":1,"facet":"structure","pair":null,"text":"公司没定流程的时候，我也能把这活做完"},
 {"id":"q168","dim":"JP","dir":1,"facet":"structure","pair":null,"text":"回家后，外套和包我随手往椅背上一搭"},
 {"id":"q169","dim":"JP","dir":1,"facet":"structure","pair":null,"text":"我的周末安排，没有什么固定的先后"},
 {"id":"q170","dim":"JP","dir":1,"facet":"structure","pair":null,"text":"新买的咖啡机没说明书，我也能摆弄明白"},
 {"id":"q171","dim":"JP","dir":-1,"facet":"decisive","pair":"C-JP-decisive","text":"在餐厅看菜单，我大概两分钟就点好了"},
 {"id":"q172","dim":"JP","dir":-1,"facet":"decisive","pair":null,"text":"周几去旅行定下来后，我不想再换日子"},
 {"id":"q173","dim":"JP","dir":-1,"facet":"decisive","pair":null,"text":"周一开会讨论到差不多，我就说就这么办"},
 {"id":"q174","dim":"JP","dir":-1,"facet":"decisive","pair":null,"text":"同事问我要不要接这个项目，我当场点头"},
 {"id":"q175","dim":"JP","dir":-1,"facet":"decisive","pair":null,"text":"挑手机套餐时，我看完三个就选一个"},
 {"id":"q176","dim":"JP","dir":1,"facet":"decisive","pair":"C-JP-decisive","text":"毕业去哪个城市定居，我不想现在就定死"},
 {"id":"q177","dim":"JP","dir":1,"facet":"decisive","pair":null,"text":"点外卖时，我常把几家店留在购物车里"},
 {"id":"q178","dim":"JP","dir":1,"facet":"decisive","pair":null,"text":"换工作的事，我愿意先放两个月再说"},
 {"id":"q179","dim":"JP","dir":1,"facet":"decisive","pair":null,"text":"方案写完初稿，我先搁一晚再交上去"},
 {"id":"q180","dim":"JP","dir":1,"facet":"decisive","pair":null,"text":"两家公司都给了offer，我再等一周看看"},
 {"id":"q181","dim":"JP","dir":-1,"facet":"timing","pair":"C-JP-timing","text":"月底要交的报表，我月初就开始动手"},
 {"id":"q182","dim":"JP","dir":-1,"facet":"timing","pair":null,"text":"写这学期的课程论文，我分四次写完"},
 {"id":"q183","dim":"JP","dir":-1,"facet":"timing","pair":null,"text":"家里的家务一上手，我就想一口气做完"},
 {"id":"q184","dim":"JP","dir":-1,"facet":"timing","pair":null,"text":"待办清单上，我每天早上从第一条开始做"},
 {"id":"q185","dim":"JP","dir":-1,"facet":"timing","pair":null,"text":"早上收到的邮件，我当天就回掉大部分"},
 {"id":"q186","dim":"JP","dir":1,"facet":"timing","pair":"C-JP-timing","text":"论文后天就要截止，我今晚才开始动笔"},
 {"id":"q187","dim":"JP","dir":1,"facet":"timing","pair":null,"text":"作业下周要交，我等到最后三天才写"},
 {"id":"q188","dim":"JP","dir":1,"facet":"timing","pair":null,"text":"有整个周末的空闲，我常常下午才动手"},
 {"id":"q189","dim":"JP","dir":1,"facet":"timing","pair":null,"text":"期末报告，我常攒到交稿前一晚才开始写"},
 {"id":"q190","dim":"JP","dir":1,"facet":"timing","pair":null,"text":"答辩稿下周就要交，我这周才开始搭框架"},
 {"id":"q191","dim":"JP","dir":-1,"facet":"routine","pair":"C-JP-routine","text":"最近半年，我基本十二点前上床睡觉"},
 {"id":"q192","dim":"JP","dir":-1,"facet":"routine","pair":null,"text":"工作日的早上，我走的路子都差不多"},
 {"id":"q193","dim":"JP","dir":-1,"facet":"routine","pair":null,"text":"早饭我一般都在早上七点半左右开吃"},
 {"id":"q194","dim":"JP","dir":-1,"facet":"routine","pair":null,"text":"下班到睡前这段时间，我基本按老顺序来"},
 {"id":"q195","dim":"JP","dir":-1,"facet":"routine","pair":null,"text":"我固定在周二和周四的晚上去游泳锻炼"},
 {"id":"q196","dim":"JP","dir":1,"facet":"routine","pair":"C-JP-routine","text":"在这周里每天经历的事，差别还挺大"},
 {"id":"q197","dim":"JP","dir":1,"facet":"routine","pair":null,"text":"晚饭和睡觉的点，常看我当天忙不忙"},
 {"id":"q198","dim":"JP","dir":1,"facet":"routine","pair":null,"text":"一到周末想干啥就干啥，我过得挺自在"},
 {"id":"q199","dim":"JP","dir":1,"facet":"routine","pair":null,"text":"搬到新城市半年后，我很快适应了新节奏"},
 {"id":"q200","dim":"JP","dir":1,"facet":"routine","pair":null,"text":"我很少把某件事固定在每周的同一天"}
]
