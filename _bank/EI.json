[
 {"id":"q001","dim":"EI","dir":-1,"facet":"social","pair":"C-EI-social","text":"周一的部门晨会上，我常先跟旁边同事搭话"},
 {"id":"q002","dim":"EI","dir":-1,"facet":"social","pair":null,"text":"朋友组织的饭局上，我主动去认识新面孔"},
 {"id":"q003","dim":"EI","dir":-1,"facet":"social","pair":null,"text":"在奶茶店排队那几分钟，我跟前后的人闲聊"},
 {"id":"q004","dim":"EI","dir":-1,"facet":"social","pair":null,"text":"每周例会开始前的十分钟，我和同事聊上几句"},
 {"id":"q005","dim":"EI","dir":-1,"facet":"social","pair":null,"text":"同学群里有人提问，我总是第一个接话的人"},
 {"id":"q006","dim":"EI","dir":1,"facet":"social","pair":"C-EI-social","text":"公司年会的圆桌上，我等着别人先开口"},
 {"id":"q007","dim":"EI","dir":1,"facet":"social","pair":null,"text":"十几个人挤在KTV包间，我坐在角落听歌"},
 {"id":"q008","dim":"EI","dir":1,"facet":"social","pair":null,"text":"早上在小区门口碰见邻居，我等对方先开口"},
 {"id":"q009","dim":"EI","dir":1,"facet":"social","pair":null,"text":"社团活动中间休息时，我走到窗边自己站着"},
 {"id":"q010","dim":"EI","dir":1,"facet":"social","pair":null,"text":"集体出游坐大巴那两小时，我一路看风景"},
 {"id":"q011","dim":"EI","dir":-1,"facet":"energy","pair":"C-EI-energy","text":"跟朋友唱完三小时K歌，我回家还想再聊会儿"},
 {"id":"q012","dim":"EI","dir":-1,"facet":"energy","pair":null,"text":"周末独自在家待满一整天，我就想约人吃饭"},
 {"id":"q013","dim":"EI","dir":-1,"facet":"energy","pair":null,"text":"白天连开三场会，晚上我还想约同事吃夜宵"},
 {"id":"q014","dim":"EI","dir":-1,"facet":"energy","pair":null,"text":"周末上午打完球，下午我接着去参加聚会"},
 {"id":"q015","dim":"EI","dir":-1,"facet":"energy","pair":null,"text":"跟老同学通完一小时电话，我整个人更有劲"},
 {"id":"q016","dim":"EI","dir":1,"facet":"energy","pair":"C-EI-energy","text":"参加完两小时的校友聚会，我得先独处一会儿"},
 {"id":"q017","dim":"EI","dir":1,"facet":"energy","pair":null,"text":"连着三个晚上都有饭局，我到第四天就撑不住"},
 {"id":"q018","dim":"EI","dir":1,"facet":"energy","pair":null,"text":"生日会散场回到家，我只想安静地坐一晚"},
 {"id":"q019","dim":"EI","dir":1,"facet":"energy","pair":null,"text":"上完一整天的培训课，回家我就一个人待着"},
 {"id":"q020","dim":"EI","dir":1,"facet":"energy","pair":null,"text":"吃完两小时的午饭，我想自己走一段路"},
 {"id":"q021","dim":"EI","dir":-1,"facet":"express","pair":"C-EI-express","text":"每周小组讨论时，我边说边把想法理成条理"},
 {"id":"q022","dim":"EI","dir":-1,"facet":"express","pair":null,"text":"会上冒出新点子，我当场先说出来再补充"},
 {"id":"q023","dim":"EI","dir":-1,"facet":"express","pair":null,"text":"用微信聊天时，我一句话分三四条发出去"},
 {"id":"q024","dim":"EI","dir":-1,"facet":"express","pair":null,"text":"跟同事边走边聊，我常说出没想过的思路"},
 {"id":"q025","dim":"EI","dir":-1,"facet":"express","pair":null,"text":"写方案前，我先拉同事在会议室讲一遍框架"},
 {"id":"q026","dim":"EI","dir":1,"facet":"express","pair":"C-EI-express","text":"开会轮到我发言，我要先想十几秒才开口"},
 {"id":"q027","dim":"EI","dir":1,"facet":"express","pair":null,"text":"发出那条长消息前，我从头到尾读了两遍"},
 {"id":"q028","dim":"EI","dir":1,"facet":"express","pair":null,"text":"老板突然问我进度，我停两秒才组织好话"},
 {"id":"q029","dim":"EI","dir":1,"facet":"express","pair":null,"text":"饭桌上聊起不熟的电影，我多半低头听着"},
 {"id":"q030","dim":"EI","dir":1,"facet":"express","pair":null,"text":"那句话到嘴边，我等前面的人说完再讲"},
 {"id":"q031","dim":"EI","dir":-1,"facet":"stim","pair":"C-EI-stim","text":"一个人在家待一整天，我就想开个直播听听"},
 {"id":"q032","dim":"EI","dir":-1,"facet":"stim","pair":null,"text":"周六下午空下来，我会打电话约人出门走走"},
 {"id":"q033","dim":"EI","dir":-1,"facet":"stim","pair":null,"text":"晚上在家写东西，我总要开着音乐或播客"},
 {"id":"q034","dim":"EI","dir":-1,"facet":"stim","pair":null,"text":"坐半小时地铁，我常刷着热闹的短视频"},
 {"id":"q035","dim":"EI","dir":-1,"facet":"stim","pair":null,"text":"假期连躺三天没安排，我就想找人出去玩"},
 {"id":"q036","dim":"EI","dir":1,"facet":"stim","pair":"C-EI-stim","text":"关掉音乐坐在书房里，我觉得挺舒服"},
 {"id":"q037","dim":"EI","dir":1,"facet":"stim","pair":null,"text":"在商场中庭待上半小时，我就想找长椅坐坐"},
 {"id":"q038","dim":"EI","dir":1,"facet":"stim","pair":null,"text":"写代码那两小时，我希望工位周围没有声音"},
 {"id":"q039","dim":"EI","dir":1,"facet":"stim","pair":null,"text":"朋友约我去吵闹的酒吧，我通常婉言推掉"},
 {"id":"q040","dim":"EI","dir":1,"facet":"stim","pair":null,"text":"公司聚餐挑座位时，我选靠窗那个角落"},
 {"id":"q041","dim":"EI","dir":-1,"facet":"breadth","pair":"C-EI-breadth","text":"参加完一场行业沙龙，我加了五六个微信"},
 {"id":"q042","dim":"EI","dir":-1,"facet":"breadth","pair":null,"text":"整栋办公楼里，我能叫出二十多个同事的名字"},
 {"id":"q043","dim":"EI","dir":-1,"facet":"breadth","pair":null,"text":"坐四小时高铁，我和邻座聊成了朋友"},
 {"id":"q044","dim":"EI","dir":-1,"facet":"breadth","pair":null,"text":"入职第一周，我就认识了每个部门的联系人"},
 {"id":"q045","dim":"EI","dir":-1,"facet":"breadth","pair":null,"text":"玩桌游时，我主动拉刚认识的人一起组队"},
 {"id":"q046","dim":"EI","dir":1,"facet":"breadth","pair":"C-EI-breadth","text":"平时常来往的朋友，我数下来只有两三个"},
 {"id":"q047","dim":"EI","dir":1,"facet":"breadth","pair":null,"text":"这半年周末，我反复约的就是那四个人"},
 {"id":"q048","dim":"EI","dir":1,"facet":"breadth","pair":null,"text":"新认识的人，我一般半年后才聊到私事"},
 {"id":"q049","dim":"EI","dir":1,"facet":"breadth","pair":null,"text":"聚会上加的微信，我很少再主动约人见面"},
 {"id":"q050","dim":"EI","dir":1,"facet":"breadth","pair":null,"text":"跟三个老朋友处了十年，还想一直处下去"}
]
