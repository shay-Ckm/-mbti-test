[
 {"id":"q051","dim":"SN","dir":-1,"facet":"focus","pair":"C-SN-focus","text":"听朋友讲旅行，我会记住哪天去了哪儿"},
 {"id":"q052","dim":"SN","dir":1,"facet":"focus","pair":"C-SN-focus","text":"听同事汇报，我在意他话里想说的意图"},
 {"id":"q053","dim":"SN","dir":-1,"facet":"focus","pair":null,"text":"同事换了件外套，我先注意到袖口的线"},
 {"id":"q054","dim":"SN","dir":1,"facet":"focus","pair":null,"text":"看完两小时的电影，我琢磨导演的用意"},
 {"id":"q055","dim":"SN","dir":-1,"facet":"focus","pair":null,"text":"开完半小时的会，我还记得对方的原话"},
 {"id":"q056","dim":"SN","dir":1,"facet":"focus","pair":null,"text":"一周里遇到的几件小事，我能串成一条线"},
 {"id":"q057","dim":"SN","dir":-1,"facet":"focus","pair":null,"text":"看新闻时，我记下事发的时间和人数"},
 {"id":"q058","dim":"SN","dir":1,"facet":"focus","pair":null,"text":"一件小事，我常想到它后面的连锁反应"},
 {"id":"q059","dim":"SN","dir":-1,"facet":"focus","pair":null,"text":"逛超市时，我一眼就注意到包装的颜色"},
 {"id":"q060","dim":"SN","dir":1,"facet":"focus","pair":null,"text":"饭桌上聊天，我留意话题一会儿转到哪儿"},
 {"id":"q061","dim":"SN","dir":-1,"facet":"source","pair":"C-SN-source","text":"判断一条消息真假，我先看有没有实拍视频"},
 {"id":"q062","dim":"SN","dir":1,"facet":"source","pair":"C-SN-source","text":"见过一面的人，我凭直觉猜他的性格"},
 {"id":"q063","dim":"SN","dir":-1,"facet":"source","pair":null,"text":"朋友推荐的面馆，我会自己去吃一碗"},
 {"id":"q064","dim":"SN","dir":1,"facet":"source","pair":null,"text":"没有标准答案的谜题，我能琢磨一晚上"},
 {"id":"q065","dim":"SN","dir":-1,"facet":"source","pair":null,"text":"做菜时，我照着以前做惯的那几步来"},
 {"id":"q066","dim":"SN","dir":1,"facet":"source","pair":null,"text":"在完全不同的两件事上，我看出相似的规律"},
 {"id":"q067","dim":"SN","dir":-1,"facet":"source","pair":null,"text":"听到一个说法，我会去翻它的原始报道"},
 {"id":"q068","dim":"SN","dir":1,"facet":"source","pair":null,"text":"洗澡时突然冒出的念头，我会记下来"},
 {"id":"q069","dim":"SN","dir":-1,"facet":"source","pair":null,"text":"同事说的新方法，我亲手试过一遍才信"},
 {"id":"q070","dim":"SN","dir":1,"facet":"source","pair":null,"text":"半夜冒出来的灵感，我顺着它往下想"},
 {"id":"q071","dim":"SN","dir":-1,"facet":"style","pair":"C-SN-style","text":"接到新任务，我先问清第一步做什么"},
 {"id":"q072","dim":"SN","dir":1,"facet":"style","pair":"C-SN-style","text":"用一台新设备，我想弄清它运转的原理"},
 {"id":"q073","dim":"SN","dir":-1,"facet":"style","pair":null,"text":"学新软件时，我边点边试，很快上手"},
 {"id":"q074","dim":"SN","dir":1,"facet":"style","pair":null,"text":"一句玩笑话，我常琢磨它背后的含义"},
 {"id":"q075","dim":"SN","dir":-1,"facet":"style","pair":null,"text":"我倾向接当天下班前能做完、看得见成果的活"},
 {"id":"q076","dim":"SN","dir":1,"facet":"style","pair":null,"text":"公司两件麻烦事之间的关联，我想弄明白"},
 {"id":"q077","dim":"SN","dir":-1,"facet":"style","pair":null,"text":"别人讲道理，我要听一个具体的例子"},
 {"id":"q078","dim":"SN","dir":1,"facet":"style","pair":null,"text":"身边大大小小的事，我常归到一个框架里"},
 {"id":"q079","dim":"SN","dir":-1,"facet":"style","pair":null,"text":"动手装柜子之前，我先摸清操作步骤"},
 {"id":"q080","dim":"SN","dir":1,"facet":"style","pair":null,"text":"遇到麻烦，我先想它属于哪一类问题"},
 {"id":"q081","dim":"SN","dir":-1,"facet":"time","pair":"C-SN-time","text":"十年后的日子，我很少花时间去设想"},
 {"id":"q082","dim":"SN","dir":1,"facet":"time","pair":"C-SN-time","text":"我经常设想五年后日子会过成什么光景"},
 {"id":"q083","dim":"SN","dir":-1,"facet":"time","pair":null,"text":"聊起家里事，我说的是这个月的情况"},
 {"id":"q084","dim":"SN","dir":1,"facet":"time","pair":null,"text":"一件事做完，我常想换一种做法会怎样"},
 {"id":"q085","dim":"SN","dir":-1,"facet":"time","pair":null,"text":"我盯着这个月要交的房租、水电和网费"},
 {"id":"q086","dim":"SN","dir":1,"facet":"time","pair":null,"text":"现在这份工作十年后能否留下来，我常琢磨"},
 {"id":"q087","dim":"SN","dir":-1,"facet":"time","pair":null,"text":"说起十年后的生活，我提不起什么兴趣"},
 {"id":"q088","dim":"SN","dir":1,"facet":"time","pair":null,"text":"手机出新款，我会想它五年后变成什么样"},
 {"id":"q089","dim":"SN","dir":-1,"facet":"time","pair":null,"text":"我的心思大多放在今天要办的事情上"},
 {"id":"q090","dim":"SN","dir":1,"facet":"time","pair":null,"text":"下个月还没发生的事，我常提前在心里过一遍"},
 {"id":"q091","dim":"SN","dir":-1,"facet":"change","pair":"C-SN-change","text":"旧手机用顺手了，我不打算再换一部"},
 {"id":"q092","dim":"SN","dir":1,"facet":"change","pair":"C-SN-change","text":"新出的电子产品，我总想先买来试试"},
 {"id":"q093","dim":"SN","dir":-1,"facet":"change","pair":null,"text":"常去的小馆子，我点那几样熟悉的菜"},
 {"id":"q094","dim":"SN","dir":1,"facet":"change","pair":null,"text":"在网上买护手霜，我常挑没见过的牌子"},
 {"id":"q095","dim":"SN","dir":-1,"facet":"change","pair":null,"text":"上下班走熟的那条路，我很少换路线"},
 {"id":"q096","dim":"SN","dir":1,"facet":"change","pair":null,"text":"做过几遍的菜，我换个法子再做一次"},
 {"id":"q097","dim":"SN","dir":-1,"facet":"change","pair":null,"text":"家里的沙发和柜子，我习惯一直摆在原位"},
 {"id":"q098","dim":"SN","dir":1,"facet":"change","pair":null,"text":"入秋换季时，我会买件不同风格的衬衫"},
 {"id":"q099","dim":"SN","dir":-1,"facet":"change","pair":null,"text":"用了五年的老牌子，我不太想换新的"},
 {"id":"q100","dim":"SN","dir":1,"facet":"change","pair":null,"text":"和同事吃饭，我爱听没听过的新观点"}
]
