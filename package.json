{
  "name": "mbti-personality-test",
  "version": "2.1.0",
  "private": true,
  "description": "纯前端 MBTI 人格测试（双档位题库 24/60 题 · 置信度与一致性校验 · 完整测评报告）",
  "keywords": ["mbti", "personality-test", "vanilla-js", "static-site"],
  "license": "MIT",
  "scripts": {
    "test": "node mbti-static.test.js && node mbti-logic.test.js && node mbti-smoke.test.js && node mbti-sw.test.js",
    "test:static": "node mbti-static.test.js",
    "test:logic": "node mbti-logic.test.js",
    "test:smoke": "node mbti-smoke.test.js",
    "test:sw": "node mbti-sw.test.js",
    "icons": "node tools/make-icons.js",
    "fonts": "node tools/fetch-fonts.js",
    "types": "node tools/make-type-pages.js",
    "push": "node tools/push-via-api.js",
    "push:check": "node tools/push-via-api.js --local-only",
    "audit:css": "node tools/audit-css.js"
  },
  "engines": {
    "node": ">=16"
  }
}
